{
  "name": "@animichi/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Pi harness tasks and preserved statistical oracles for Logfire evaluations.",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\" && pnpm run test:fixture-drift",
    "test:native": "node --import tsx --test \"test/native-*.test.ts\"",
    "test:fixture-drift": "bash scripts/export-fixtures.sh && bash ../../scripts/local-gates/eval-fixture-drift.sh"
  },
  "dependencies": {
    "@animichi/agent": "workspace:*",
    "@animichi/contract": "workspace:*",
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "logfire": "0.22.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "tsx": "4.23.1"
  }
}
